# 数据库配置
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/data_analysis"

# Redis配置
REDIS_URL="redis://localhost:6379"

# JWT配置
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# 文件存储配置
UPLOAD_PATH="./uploads"
RESULTS_PATH="./results"
SCRIPTS_PATH="/path/to/your/scripts"

# 服务器配置
PORT=3000
NODE_ENV="development"

# 邮件配置（可选）
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# 文件上传限制
MAX_FILE_SIZE="100MB"
ALLOWED_FILE_TYPES="csv,xlsx,txt,json,py,R,sql"

# 脚本执行配置
SCRIPT_TIMEOUT=300000
MAX_CONCURRENT_EXECUTIONS=5

# 日志配置
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"

# 安全配置
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# 监控配置（可选）
SENTRY_DSN=""
PROMETHEUS_ENABLED=false
